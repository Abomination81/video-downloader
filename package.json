{
  "name": "video-downloader",
  "version": "0.13.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/build-screenshot-companion.mjs && node scripts/build-protection-companion.mjs && node scripts/build-browsing.mjs && node scripts/build-unified.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:helper": "uv run --project helper --extra dev pytest helper/tests -q",
    "test:browser": "node scripts/browser-check.mjs",
    "test:interactions": "node scripts/interaction-check.mjs",
    "test:updates": "node scripts/update-browser-check.mjs",
    "package": "npm run build && uv run --python 3.13 scripts/package.py",
    "test:formats": "node scripts/formats-browser-check.mjs",
    "test:menus": "node scripts/companion-browser-check.mjs",
    "test:screenshot": "node scripts/unified-browser-check.mjs",
    "test:protection": "node scripts/protection-browser-check.mjs",
    "test:browsing": "node scripts/browsing-browser-check.mjs",
    "test:security": "node scripts/browsing-security-check.mjs",
    "test:unified": "node scripts/unified-browser-check.mjs"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "18.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ghostery/adblocker": "2.20.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "shaka-player": "4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
